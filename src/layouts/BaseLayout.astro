---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Astro Firebase App",
  description = "An application built with Astro and Firebase",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/" class="logo">Astro Firebase</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/auth">Authentication</a>
          <a href="/dashboard">Dashboard</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Astro Firebase App</p>
    </footer>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    color: #1f2937;
    background: #f9fafb;
    line-height: 1.6;
  }

  header {
    background: white;
    border-bottom: 1px solid #e5e7eb;
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    color: #7c3aed;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav-links a {
    color: #374151;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: #7c3aed;
  }

  main {
    width: min(100% - 2rem, 1100px);
    min-height: 75vh;
    margin: 2rem auto;
  }

  footer {
    padding: 1.5rem;
    text-align: center;
    color: #6b7280;
    background: white;
    border-top: 1px solid #e5e7eb;
  }
</style>